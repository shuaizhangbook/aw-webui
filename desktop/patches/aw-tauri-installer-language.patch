+fn installer_locale_from_executable(executable: &Path) -> Option<&'static str> {
+    let language_file = executable.parent()?.join(CLARITIDE_INSTALLER_LANGUAGE_FILE);
+    let value = read_to_string(language_file).ok()?;
+    match value.trim().to_ascii_lowercase().as_str() {
+        "en" | "en-us" | "english" => Some("en"),
+        "zh" | "zh-cn" | "chinesesimplified" => Some("zh-CN"),
+        _ => None,
+    }
+}
+
