+fn fresh_sync_cursor_timestamp(now_ms: u64) -> String {
+    // Skip the complete five-minute window containing the identity switch.
+    // The sync agent preserves this future cursor until the boundary is sealed,
+    // so no activity from the previous account or team can be replayed.
+    let remainder = now_ms % 300_000;
+    let next_boundary_ms = if remainder == 0 {
+        now_ms
+    } else {
+        now_ms.saturating_add(300_000 - remainder)
+    };
+    DateTime::<Utc>::from_timestamp_millis(next_boundary_ms as i64)
+        .expect("current SeeSeeYou timestamp must be representable")
+        .to_rfc3339_opts(SecondsFormat::Millis, true)
+}
+
+fn seed_fresh_sync_cursor() -> Result<(), String> {
+    let state_path = dirs::get_config_dir()
+        .expect("Failed to get SeeSeeYou config dir")
+        .join("state.json");
+    let identity_not_before_utc = fresh_sync_cursor_timestamp(now_unix_ms());
+    let serialized = serde_json::to_vec_pretty(&serde_json::json!({
+        "last_window_end_utc": identity_not_before_utc.clone(),
+        "identity_not_before_utc": identity_not_before_utc,
+        "pending_records": [],
+    }))
+    .map_err(|error| format!("Unable to encode fresh sync cursor: {error}"))?;
+    write(state_path, serialized)
+        .map_err(|error| format!("Unable to initialize fresh sync cursor: {error}"))
+}
