+fn sync_config_path() -> PathBuf {
+    dirs::get_config_dir()
+        .expect("Failed to get SeeSeeYou config dir")
+        .join("sync-config.json")
+}
+
+fn sync_binary_path() -> Option<PathBuf> {
+    let parent = std::env::current_exe().ok()?.parent()?.to_path_buf();
+    #[cfg(target_os = "windows")]
+    let filename = "seeseeyou-sync.exe";
+    #[cfg(not(target_os = "windows"))]
+    let filename = "seeseeyou-sync";
+    Some(parent.join(filename))
+}
+
+fn run_sync_once() -> Result<(), String> {
+    let config_path = sync_config_path();
+    let binary_path = sync_binary_path().ok_or_else(|| "Unable to locate sync program".to_string())?;
+    if !config_path.exists() || !binary_path.exists() {
+        return Ok(());
+    }
+    let mut command = Command::new(binary_path);
+    command.arg("--config").arg(config_path);
+    #[cfg(target_os = "windows")]
+    command.creation_flags(0x08000000);
+    command
+        .spawn()
+        .map(|_| ())
+        .map_err(|error| format!("Unable to start SeeSeeYou sync: {error}"))
+}
+
+fn start_sync_scheduler() {
+    if SYNC_SCHEDULER_STARTED.set(()).is_err() {
+        return;
+    }
+    thread::spawn(|| loop {
+        if let Err(error) = run_sync_once() {
+            warn!("{error}");
+        }
+        thread::sleep(Duration::from_secs(300));
+    });
+}
+
+#[tauri::command]
+fn get_sync_status() -> bool {
+    sync_config_path().exists() && sync_binary_path().is_some_and(|path| path.exists())
+}
+
+#[tauri::command]
+fn configure_sync(config: DesktopSyncConfig) -> Result<(), String> {
+    if config.server_url.trim().is_empty()
+        || config.local_api_url.trim().is_empty()
+        || config.device_id.trim().is_empty()
+        || config.employee_id.trim().is_empty()
+        || config.device_key.trim().is_empty()
+        || config.hmac_secret.trim().is_empty()
+    {
+        return Err("Incomplete sync configuration".to_string());
+    }
+    let serialized = serde_json::to_vec_pretty(&config)
+        .map_err(|error| format!("Unable to encode sync configuration: {error}"))?;
+    write(sync_config_path(), serialized)
+        .map_err(|error| format!("Unable to save sync configuration: {error}"))?;
+    run_sync_once()
+}
+
+#[tauri::command]
+fn clear_sync() -> Result<(), String> {
+    let path = sync_config_path();
+    if path.exists() {
+        remove_file(path).map_err(|error| format!("Unable to clear sync configuration: {error}"))?;
+    }
+    Ok(())
+}
