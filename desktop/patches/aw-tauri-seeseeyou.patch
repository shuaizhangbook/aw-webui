+fn validate_sync_config(config: &DesktopSyncConfig) -> Result<(), String> {
+    if config.server_url.trim().is_empty()
+        || config.local_api_url.trim().is_empty()
+        || config.device_id.trim().is_empty()
+        || config.employee_id.trim().is_empty()
+        || config.device_key.trim().is_empty()
+        || config.hmac_secret.trim().is_empty()
+    {
+        return Err("Incomplete sync configuration".to_string());
+    }
+    if config.server_url.trim().trim_end_matches('/') != "https://watch.sding.me" {
+        return Err("Untrusted SeeSeeYou sync server".to_string());
+    }
+    if !matches!(
+        config.local_api_url.trim().trim_end_matches('/'),
+        "http://localhost:5600/api/0" | "http://127.0.0.1:5600/api/0"
+    ) {
+        return Err("Unsupported local activity API".to_string());
+    }
+    Ok(())
+}
+
+fn migrate_sync_config_local_api_url(config: &mut DesktopSyncConfig) -> bool {
+    let current = config.local_api_url.trim().trim_end_matches('/');
+    if matches!(
+        current,
+        "http://localhost:5601/api/0" | "http://127.0.0.1:5601/api/0"
+    ) {
+        config.local_api_url = DEFAULT_LOCAL_API_URL.to_string();
+        true
+    } else {
+        false
+    }
+}
+
+fn migrate_sync_config_to_port_5600() -> Result<(), String> {
+    let path = sync_config_path();
+    if !path.exists() {
+        return Ok(());
+    }
+
+    let contents = read_to_string(&path)
+        .map_err(|error| format!("Unable to read sync configuration: {error}"))?;
+    let mut config: DesktopSyncConfig = serde_json::from_str(&contents)
+        .map_err(|error| format!("Unable to decode sync configuration: {error}"))?;
+    if !migrate_sync_config_local_api_url(&mut config) {
+        return Ok(());
+    }
+
+    validate_sync_config(&config)?;
+    write_sync_config_atomically(&config)
+        .map_err(|error| format!("Unable to migrate sync configuration to port 5600: {error}"))?;
+    info!("Migrated SeeSeeYou sync API from port 5601 to 5600");
+    Ok(())
+}
+
+fn write_sync_config_atomically(config: &DesktopSyncConfig) -> Result<(), String> {
+    validate_sync_config(config)?;
+    let path = sync_config_path();
+    let temporary = path.with_extension("json.tmp");
+    let backup = path.with_extension("json.bak");
+    let serialized = serde_json::to_vec_pretty(config)
+        .map_err(|error| format!("Unable to encode sync configuration: {error}"))?;
+    let mut temporary_file = OpenOptions::new()
+        .create(true)
+        .truncate(true)
+        .write(true)
+        .open(&temporary)
+        .map_err(|error| format!("Unable to open temporary sync configuration: {error}"))?;
+    temporary_file
+        .write_all(&serialized)
+        .and_then(|_| temporary_file.sync_all())
+        .map_err(|error| format!("Unable to save temporary sync configuration: {error}"))?;
+    drop(temporary_file);
+    if backup.exists() {
+        remove_file(&backup)
+            .map_err(|error| format!("Unable to remove an old sync backup: {error}"))?;
+    }
+    if path.exists() {
+        rename(&path, &backup)
+            .map_err(|error| format!("Unable to back up sync configuration: {error}"))?;
+    }
+    if let Err(error) = rename(&temporary, &path) {
+        if backup.exists() {
+            let _ = rename(&backup, &path);
+        }
+        return Err(format!("Unable to activate sync configuration: {error}"));
+    }
+    if backup.exists() {
+        remove_file(backup)
+            .map_err(|error| format!("Unable to remove sync configuration backup: {error}"))?;
+    }
+    Ok(())
+}
+
+fn load_validated_sync_config() -> Result<Option<DesktopSyncConfig>, String> {
+    migrate_sync_config_to_port_5600()?;
+    let path = sync_config_path();
+    if !path.exists() {
+        return Ok(None);
+    }
+    let contents = read_to_string(&path)
+        .map_err(|error| format!("Unable to read sync configuration: {error}"))?;
+    let config = serde_json::from_str::<DesktopSyncConfig>(&contents)
+        .map_err(|error| format!("Unable to decode sync configuration: {error}"))?;
+    validate_sync_config(&config)?;
+    Ok(Some(config))
+}
