+fn update_sync_runtime(update: impl FnOnce(&mut SyncRuntimeState)) {
+    let state = SYNC_RUNTIME.get_or_init(|| Mutex::new(SyncRuntimeState::default()));
+    if let Ok(mut state) = state.lock() {
+        update(&mut state);
+    }
+}
