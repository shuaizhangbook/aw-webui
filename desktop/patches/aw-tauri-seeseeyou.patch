+/// Returns true only when the child completed a real successful upload pass.
+/// A false result means the pass was cancelled because the account was paused
+/// or changed while the child was running.
+fn run_sync_once(port: u16) -> Result<bool, String> {
+    if sync_paused_path().exists()
+        || sync_rebind_pending_path().exists()
+        || load_validated_sync_config()?.is_none()
+    {
+        return Ok(false);
+    }
+    let generation = SYNC_GENERATION.load(Ordering::SeqCst);
+    if !wait_for_required_buckets(port, generation)? {
+        return Ok(false);
+    }
+    update_sync_runtime(|state| state.bucket_ready = true);
+    let config_path = sync_config_path();
+    let binary_path = sync_binary_path().ok_or_else(|| "Unable to locate sync program".to_string())?;
+    if !binary_path.exists() {
+        return Err("SeeSeeYou sync program is missing".to_string());
+    }
+    let mut command = Command::new(binary_path);
+    command.arg("--config").arg(config_path);
+    #[cfg(target_os = "windows")]
+    command.creation_flags(0x08000000);
+    let mut child = command
+        .spawn()
+        .map_err(|error| format!("Unable to start SeeSeeYou sync: {error}"))?;
+    loop {
+        if generation != SYNC_GENERATION.load(Ordering::SeqCst) || sync_paused_path().exists() {
+            let _ = child.kill();
+            let _ = child.wait();
+            return Ok(false);
+        }
+        let status = match child.try_wait() {
+            Ok(status) => status,
+            Err(error) => {
+                let _ = child.kill();
+                let _ = child.wait();
+                return Err(format!("Unable to read SeeSeeYou sync status: {error}"));
+            }
+        };
+        match status {
+            Some(status) if status.success() => return Ok(true),
+            Some(status) => return Err(format!("SeeSeeYou sync exited with status {status}")),
+            None => thread::sleep(Duration::from_millis(100)),
+        }
+    }
+}
+
+fn wait_for_local_server(port: u16) -> Result<(), String> {
+    let address = SocketAddr::from(([127, 0, 0, 1], port));
+    let deadline = Instant::now() + Duration::from_secs(60);
+    while TcpStream::connect_timeout(&address, Duration::from_millis(250)).is_err() {
+        if Instant::now() >= deadline {
+            return Err(format!("Local SeeSeeYou server did not start on port {port}"));
+        }
+        thread::sleep(Duration::from_millis(250));
+    }
+    info!("Local SeeSeeYou server is ready on port {port}");
+    Ok(())
+}
+
+fn bucket_metadata_ready(value: &serde_json::Value) -> bool {
+    let Some(buckets) = value.as_object() else {
+        return false;
+    };
+    let mut window_ready = false;
+    let mut afk_ready = false;
+    for (bucket_id, metadata) in buckets {
+        let bucket_type = metadata
+            .get("type")
+            .and_then(serde_json::Value::as_str)
+            .unwrap_or_default()
+            .to_ascii_lowercase();
+        let lowered_id = bucket_id.to_ascii_lowercase();
+        window_ready |= bucket_type == "currentwindow" || lowered_id.contains("watcher-window");
+        afk_ready |= bucket_type == "afkstatus" || lowered_id.contains("watcher-afk");
+    }
+    window_ready && afk_ready
+}
+
+fn local_buckets_ready(port: u16) -> bool {
+    let address = SocketAddr::from(([127, 0, 0, 1], port));
+    let Ok(mut stream) = TcpStream::connect_timeout(&address, Duration::from_millis(500)) else {
+        return false;
+    };
+    let request = b"GET /api/0/buckets HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n";
+    if stream.write_all(request).is_err() {
+        return false;
+    }
+    let _ = stream.set_read_timeout(Some(Duration::from_secs(2)));
+    let mut response = String::new();
+    if stream.read_to_string(&mut response).is_err() {
+        return false;
+    }
+    let Some((headers, body)) = response.split_once("\r\n\r\n") else {
+        return false;
+    };
+    if !headers.starts_with("HTTP/1.1 200") && !headers.starts_with("HTTP/1.0 200") {
+        return false;
+    }
+    serde_json::from_str(body)
+        .ok()
+        .is_some_and(|value| bucket_metadata_ready(&value))
+}
+
+fn wait_for_required_buckets(port: u16, generation: u64) -> Result<bool, String> {
+    let deadline = Instant::now() + Duration::from_secs(60);
+    loop {
+        if generation != SYNC_GENERATION.load(Ordering::SeqCst) || sync_paused_path().exists() {
+            return Ok(false);
+        }
+        if local_buckets_ready(port) {
+            info!("Local SeeSeeYou window and AFK collectors are ready");
+            return Ok(true);
+        }
+        if Instant::now() >= deadline {
+            return Err("Local window and AFK collectors are still starting".to_string());
+        }
+        thread::sleep(Duration::from_secs(1));
+    }
+}
+
+fn queue_sync_trigger(sender: &mpsc::SyncSender<()>) -> Result<(), String> {
+    match sender.try_send(()) {
+        Ok(()) | Err(mpsc::TrySendError::Full(())) => Ok(()),
+        Err(mpsc::TrySendError::Disconnected(())) => {
+            Err("SeeSeeYou sync scheduler is unavailable".to_string())
+        }
+    }
+}
+
+fn trigger_sync() -> Result<(), String> {
+    let sender = SYNC_TRIGGER
+        .get()
+        .ok_or_else(|| "SeeSeeYou sync scheduler is not ready".to_string())?;
+    queue_sync_trigger(sender)
+}
+
+fn start_sync_scheduler(port: u16) {
+    let (sender, receiver) = mpsc::sync_channel(1);
+    if SYNC_TRIGGER.set(sender).is_err() {
+        return;
+    }
+
+    thread::spawn(move || {
+        while let Err(error) = wait_for_local_server(port) {
+            update_sync_runtime(|state| state.last_error = Some(error.clone()));
+            warn!("{error}; retrying local server readiness");
+            thread::sleep(Duration::from_secs(15));
+        }
+        // Never upload an old on-disk identity until the authenticated workspace
+        // explicitly resumes it. This closes the cold-start/logout race.
+        if receiver.recv().is_err() {
+            return;
+        }
+        loop {
+            // Coalesce any number of requests into one run. The worker waits for
+            // each child to exit, so state.json and the canonical outbox never
+            // have two desktop-managed sync processes writing at the same time.
+            while receiver.try_recv().is_ok() {}
+            let config_ready = !sync_rebind_pending_path().exists()
+                && match load_validated_sync_config() {
+                    Ok(Some(_)) => true,
+                    Ok(None) => false,
+                    Err(error) => {
+                        update_sync_runtime(|state| state.last_error = Some(error));
+                        false
+                    }
+                };
+            if sync_paused_path().exists() || !config_ready {
+                match receiver.recv() {
+                    Ok(()) => continue,
+                    Err(_) => break,
+                }
+            }
+            update_sync_runtime(|state| {
+                state.running = true;
+                state.bucket_ready = false;
+                state.last_attempt_at_ms = Some(now_unix_ms());
+                state.last_error = None;
+            });
+            let retry_after = match run_sync_once(port) {
+                Ok(true) => {
+                    update_sync_runtime(|state| {
+                        state.running = false;
+                        state.last_success_at_ms = Some(now_unix_ms());
+                        state.last_error = None;
+                    });
+                    Duration::from_secs(300)
+                }
+                Ok(false) => {
+                    update_sync_runtime(|state| {
+                        state.running = false;
+                        state.last_error = None;
+                    });
+                    continue;
+                }
+                Err(error) => {
+                    update_sync_runtime(|state| {
+                        state.running = false;
+                        state.last_error = Some(error.clone());
+                    });
+                    warn!("{error}");
+                    // Watchers and the network often warm up after the local API.
+                    // Retry cold-start failures quickly before the normal cadence.
+                    Duration::from_secs(15)
+                }
+            };
+            match receiver.recv_timeout(retry_after) {
+                Ok(()) | Err(mpsc::RecvTimeoutError::Timeout) => {}
+                Err(mpsc::RecvTimeoutError::Disconnected) => break,
+            }
+        }
+    });
+}
