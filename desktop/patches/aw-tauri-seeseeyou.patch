+      }
+      return;
+    }
+    if (!force && token === lastSessionToken && teamSelection === lastTeamSelection &&
+        Date.now() - lastSyncAttempt < 30000) return;
+
+    syncRunning = true;
+    syncRerunRequested = false;
+    lastSyncAttempt = Date.now();
