+fn sync_config_path() -> PathBuf {
+    dirs::get_config_dir()
+        .expect("Failed to get SeeSeeYou config dir")
+        .join("sync-config.json")
+}
+
+fn sync_binary_path() -> Option<PathBuf> {
+    let parent = std::env::current_exe().ok()?.parent()?.to_path_buf();
+    #[cfg(target_os = "windows")]
+    let filename = "seeseeyou-sync.exe";
+    #[cfg(not(target_os = "windows"))]
+    let filename = "seeseeyou-sync";
+    Some(parent.join(filename))
+}
+
+fn migrate_sync_config_local_api_url(config: &mut DesktopSyncConfig) -> bool {
+    let current = config.local_api_url.trim().trim_end_matches('/');
+    if matches!(
+        current,
+        "http://localhost:5601/api/0" | "http://127.0.0.1:5601/api/0"
+    ) {
+        config.local_api_url = DEFAULT_LOCAL_API_URL.to_string();
+        true
+    } else {
+        false
+    }
+}
+
+fn migrate_sync_config_to_port_5600() -> Result<(), String> {
+    let path = sync_config_path();
+    if !path.exists() {
+        return Ok(());
+    }
+
+    let contents = read_to_string(&path)
+        .map_err(|error| format!("Unable to read sync configuration: {error}"))?;
+    let mut config: DesktopSyncConfig = serde_json::from_str(&contents)
+        .map_err(|error| format!("Unable to decode sync configuration: {error}"))?;
+    if !migrate_sync_config_local_api_url(&mut config) {
+        return Ok(());
+    }
+
+    let serialized = serde_json::to_vec_pretty(&config)
+        .map_err(|error| format!("Unable to encode migrated sync configuration: {error}"))?;
+    write(&path, serialized)
+        .map_err(|error| format!("Unable to migrate sync configuration to port 5600: {error}"))?;
+    info!("Migrated SeeSeeYou sync API from port 5601 to 5600");
+    Ok(())
+}
+
+fn run_sync_once() -> Result<(), String> {
+    migrate_sync_config_to_port_5600()?;
+    let config_path = sync_config_path();
+    let binary_path = sync_binary_path().ok_or_else(|| "Unable to locate sync program".to_string())?;
+    if !config_path.exists() || !binary_path.exists() {
+        return Ok(());
+    }
+    let mut command = Command::new(binary_path);
+    command.arg("--config").arg(config_path);
+    #[cfg(target_os = "windows")]
+    command.creation_flags(0x08000000);
+    let status = command
+        .status()
+        .map_err(|error| format!("Unable to start SeeSeeYou sync: {error}"))?;
+    if status.success() {
+        Ok(())
+    } else {
+        Err(format!("SeeSeeYou sync exited with status {status}"))
+    }
+}
+
+fn wait_for_local_server(port: u16) {
+    let address = SocketAddr::from(([127, 0, 0, 1], port));
+    while TcpStream::connect_timeout(&address, Duration::from_millis(250)).is_err() {
+        thread::sleep(Duration::from_millis(250));
+    }
+    info!("Local SeeSeeYou server is ready on port {port}");
+}
+
+fn queue_sync_trigger(sender: &mpsc::SyncSender<()>) -> Result<(), String> {
+    match sender.try_send(()) {
+        Ok(()) | Err(mpsc::TrySendError::Full(())) => Ok(()),
+        Err(mpsc::TrySendError::Disconnected(())) => {
+            Err("SeeSeeYou sync scheduler is unavailable".to_string())
+        }
+    }
+}
+
+fn trigger_sync() -> Result<(), String> {
+    let sender = SYNC_TRIGGER
+        .get()
+        .ok_or_else(|| "SeeSeeYou sync scheduler is not ready".to_string())?;
+    queue_sync_trigger(sender)
+}
+
+fn start_sync_scheduler(port: u16) {
+    let (sender, receiver) = mpsc::sync_channel(1);
+    if SYNC_TRIGGER.set(sender).is_err() {
+        return;
+    }
+
+    thread::spawn(move || {
+        wait_for_local_server(port);
+        loop {
+            // Coalesce any number of requests into one run. The worker waits for
+            // each child to exit, so state.json and the canonical outbox never
+            // have two desktop-managed sync processes writing at the same time.
+            while receiver.try_recv().is_ok() {}
+            if let Err(error) = run_sync_once() {
+                warn!("{error}");
+            }
+            match receiver.recv_timeout(Duration::from_secs(300)) {
+                Ok(()) | Err(mpsc::RecvTimeoutError::Timeout) => {}
+                Err(mpsc::RecvTimeoutError::Disconnected) => break,
+            }
+        }
+    });
+}
+
+#[tauri::command]
+fn get_sync_status() -> DesktopSyncStatus {
+    let migration_ok = migrate_sync_config_to_port_5600().is_ok();
+    let binary_ready = sync_binary_path().is_some_and(|path| path.exists());
+    let config = if migration_ok {
+        read_to_string(sync_config_path())
+            .ok()
+            .and_then(|contents| serde_json::from_str::<DesktopSyncConfig>(&contents).ok())
+    } else {
+        None
+    };
+    DesktopSyncStatus {
+        configured: config.is_some() && binary_ready,
+        employee_id: config.as_ref().map(|value| value.employee_id.clone()),
+        team_id: config.and_then(|value| value.team_id),
+    }
+}
+
+#[tauri::command]
+fn configure_sync(config: DesktopSyncConfig) -> Result<(), String> {
+    if config.server_url.trim().is_empty()
+        || config.local_api_url.trim().is_empty()
+        || config.device_id.trim().is_empty()
+        || config.employee_id.trim().is_empty()
+        || config.device_key.trim().is_empty()
+        || config.hmac_secret.trim().is_empty()
+    {
+        return Err("Incomplete sync configuration".to_string());
+    }
+    let serialized = serde_json::to_vec_pretty(&config)
+        .map_err(|error| format!("Unable to encode sync configuration: {error}"))?;
+    write(sync_config_path(), serialized)
+        .map_err(|error| format!("Unable to save sync configuration: {error}"))?;
+    trigger_sync()
+}
+
+#[tauri::command]
+fn clear_sync() -> Result<(), String> {
+    let path = sync_config_path();
+    if path.exists() {
+        remove_file(path).map_err(|error| format!("Unable to clear sync configuration: {error}"))?;
+    }
+    Ok(())
+}
