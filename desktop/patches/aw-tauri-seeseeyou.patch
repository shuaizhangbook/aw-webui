+fn cancel_active_sync() -> Result<(), String> {
+    SYNC_GENERATION.fetch_add(1, Ordering::SeqCst);
+    let deadline = Instant::now() + Duration::from_secs(5);
+    loop {
+        let running = SYNC_RUNTIME
+            .get_or_init(|| Mutex::new(SyncRuntimeState::default()))
+            .lock()
+            .map(|state| state.running)
+            .unwrap_or(false);
+        if !running {
+            return Ok(());
+        }
+        if Instant::now() >= deadline {
+            return Err("Timed out while stopping the previous sync".to_string());
+        }
+        thread::sleep(Duration::from_millis(50));
+    }
+}
